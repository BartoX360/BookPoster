<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@800;900&family=IBM+Plex+Mono:wght@400;500;600&display=block" rel="stylesheet">
<style>
  .view:has(> .bp) { position: relative; padding: 0; overflow: hidden; }
  /* mashups des écrans gris et couleur : le framework y met les vues à z-index -2, ce qui une fois
     la vue positionnée la ferait passer sous le fond de l'écran (rendu tout blanc) */
  .trmnl .screen .mashup .view:has(> .bp) { z-index: 0; }
  .bp { position: absolute; inset: 0; overflow: hidden; container-type: size;
        --bg: #f2eee6; --ink: #111111; --muted: #444455; --sky: #ccddee; --ray: #dde8f3; --top: #444455;
        --accent: #dd2233; --on-accent: #ffffff; --book-fill: #ffffff;
        --sky-h: 64%; --pad: 4.4cqw; --f-top: max(11px, 1.35cqw); --f-meta: max(12px, 1.45cqw);
        --f-title: 6.2cqw; --f-sub: max(12px, 1.5cqw); --stamp: min(10.5cqw, 17cqh); --shadow: max(6px, .8cqw);
        background: var(--bg); color: var(--ink); font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  /* une couleur de ciel par rubrique : soleil, ciel clair, crépuscule */
  .bp--sec-hot { --sky: #ffcc44; --ray: #ffcc88; --top: #442233; }
  .bp--sec-now { --sky: #ccddee; --ray: #e6e9ee; --top: #444455; }
  .bp--sec-upcoming { --sky: #ee9977; --ray: #ffbf80; --top: #442233; }
  .bp.bp--eink { --bg: #ffffff; --ink: #000000; --muted: #000000; --sky: #ffffff; --ray: url(#bp-dots); --top: #000000;
                 --accent: #000000; --on-accent: #ffffff; }

  .bp-sky { position: absolute; left: 0; right: 0; top: 0; height: var(--sky-h); background: var(--sky); overflow: hidden; }
  .bp-rays { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bp-art { position: absolute; left: 8%; right: 8%; top: 17%; bottom: 10%; display: flex; align-items: center; justify-content: center; }
  .bp-frame { position: relative; flex: 0 0 auto; border: max(3px, .3cqw) solid var(--ink); background: var(--ink);
              box-shadow: var(--shadow) var(--shadow) 0 var(--ink); visibility: hidden; }
  .bp-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .bp--eink .bp-frame img { filter: grayscale(1) contrast(1.15); }
  .bp--img .bp-frame { visibility: visible; }
  .bp-book { display: none; width: 72%; height: 92%; }
  .bp--noimg .bp-frame { display: none; }
  .bp--noimg .bp-book { display: block; }
  .bp-tag { position: absolute; left: calc(-1 * var(--shadow)); top: calc(-1.4 * var(--shadow)); padding: .25em .6em;
            background: var(--ink); color: var(--bg); font-size: var(--f-top); letter-spacing: .2em; text-transform: uppercase;
            white-space: nowrap; }
  .bp-tag:empty { display: none; }
  .bp-top { position: absolute; top: calc(var(--pad) * .6); left: var(--pad); right: var(--pad); display: flex;
            justify-content: space-between; gap: 2em; font-size: var(--f-top); letter-spacing: .28em;
            text-transform: uppercase; color: var(--top); white-space: nowrap; }
  .bp-top > span:first-child { overflow: hidden; text-overflow: ellipsis; }
  /* les libellés restent lisibles par-dessus les rayons */
  .bp-top > span { background: var(--sky); padding: .25em .5em; margin: -.25em -.5em; }
  .bp-upd-short { display: none; }
  .bp--half_horizontal .bp-upd-long, .bp--half_vertical .bp-upd-long, .bp--quadrant .bp-upd-long { display: none; }
  .bp--half_horizontal .bp-upd-short, .bp--half_vertical .bp-upd-short, .bp--quadrant .bp-upd-short { display: inline; }

  .bp-info { position: absolute; left: var(--pad); right: var(--pad); top: var(--sky-h); bottom: 0;
             border-top: max(2px, .25cqw) solid var(--ink); display: flex; align-items: center; gap: 3cqw; }
  .bp-text { flex: 1 1 auto; min-width: 0; }
  .bp-meta { font-size: var(--f-meta); letter-spacing: .2em; text-transform: uppercase; color: var(--muted);
             white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bp-title { font-family: 'Archivo', 'Arial Black', sans-serif; font-weight: 900; font-size: var(--f-title);
              line-height: 1.05; text-transform: uppercase; margin: .18em 0 .14em; white-space: nowrap; overflow: hidden; }
  .bp-title.wrap { white-space: normal; line-height: 1.02; overflow-wrap: anywhere; }
  .bp-sub { font-size: var(--f-sub); color: var(--muted); letter-spacing: .03em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bp-sub b { color: var(--ink); font-weight: 500; }
  .bp-next { margin-top: .45em; }
  .bp-stamp { flex: 0 0 auto; text-align: center; font-size: var(--f-top); letter-spacing: .2em; color: var(--muted);
              text-transform: uppercase; white-space: nowrap; }
  .bp-ring { display: flex; align-items: center; justify-content: center; width: var(--stamp); height: var(--stamp);
             margin: .45em auto; border-radius: 50%; background: var(--accent); color: var(--on-accent);
             transform: rotate(-8deg); font-family: 'Archivo', 'Arial Black', sans-serif; font-weight: 900;
             font-size: calc(var(--stamp) * .44); letter-spacing: -.02em; line-height: 1; }
  .bp-ring.long { font-size: calc(var(--stamp) * .3); }
  .bp-ring.word { font-size: calc(var(--stamp) * .2); letter-spacing: .02em; text-transform: uppercase; }
  .bp-ring.none { background: transparent; color: var(--ink); border: max(3px, .3cqw) solid var(--ink); }
  .bp-err .bp-meta { color: var(--accent); }
  .bp--error .bp-stamp, .bp--error .bp-next, .bp--error .bp-tag { display: none; }
  /* e-ink 1 bit : pas d'anticrénelage, il faut des traits plus épais */
  .bp--eink { font-weight: 600; --f-top: max(13px, 1.35cqw); --f-meta: max(13px, 1.45cqw); --f-sub: max(13px, 1.5cqw); }
  .bp--eink .bp-sub b { font-weight: 600; }
  .bp--eink .bp-top, .bp--eink .bp-meta { letter-spacing: .14em; }

  .bp--half_horizontal { --pad: 3cqw; --f-title: 4.6cqw; --stamp: 30cqh; }
  .bp--half_horizontal .bp-sky { right: auto; width: 34%; height: 100%; border-right: max(2px, .25cqw) solid var(--ink); }
  .bp--half_horizontal .bp-art { left: 9%; right: 11%; top: 22%; bottom: 13%; }
  .bp--half_horizontal .bp-info { left: calc(34% + var(--pad)); top: 0; border-top: 0; }
  .bp--half_horizontal .bp-top > span:first-child, .bp--half_vertical .bp-top > span:first-child,
  .bp--quadrant .bp-top > span:first-child { display: none; }
  .bp--half_horizontal .bp-top, .bp--half_vertical .bp-top, .bp--quadrant .bp-top { justify-content: flex-end; letter-spacing: .1em; }
  .bp--half_horizontal .bp-next, .bp--quadrant .bp-next { display: none; }
  .bp--half_vertical { --sky-h: 42%; --pad: 5cqw; --f-top: max(11px, 2.6cqw); --f-meta: max(11px, 2.9cqw);
                       --f-title: 9cqw; --f-sub: max(12px, 3.2cqw); --stamp: 19cqw; }
  .bp--half_vertical .bp-art { left: 6%; right: 8%; top: 17%; bottom: 12%; }
  .bp--half_vertical .bp-meta, .bp--half_vertical .bp-sub { white-space: normal; line-height: 1.5; }
  .bp--half_vertical .bp-info { align-items: flex-start; padding-top: 7cqw; }
  .bp--quadrant { --sky-h: 46%; --pad: 4.5cqw; --f-top: max(11px, 2.8cqw); --f-meta: max(11px, 2.8cqw);
                  --f-title: 7.5cqw; --f-sub: max(11px, 2.8cqw); --stamp: 15cqw; }
  .bp--quadrant .bp-art { left: 4%; right: 6%; top: 17%; bottom: 9%; }
  /* petits formats : le tampon chevauche le bas de l'affiche */
  .bp--half_vertical .bp-stamp, .bp--quadrant .bp-stamp { position: absolute; right: 0; top: calc(var(--stamp) * -.62); }
  .bp--half_vertical .bp-stamp > span, .bp--quadrant .bp-stamp > span { display: none; }
  .bp--half_vertical .bp-text, .bp--quadrant .bp-text { padding-right: calc(var(--stamp) * .55); }
  .bp--half_vertical .bp-meta, .bp--quadrant .bp-meta { margin-right: calc(var(--stamp) * .5); }
</style>

{% template bookposter %}
{%- comment -%} chaque liste Place des Libraires est une page HTML : seule l'en-tête de ses premiers livres est gardée
(titre, auteur, éditeur, date, EAN), null si la page n'a pas pu être chargée {%- endcomment -%}
{%- capture pages -%}[
{%- for k in (0..2) -%}
  {%- case k -%}{%- when 0 -%}{%- assign w = w0 -%}{%- when 1 -%}{%- assign w = w1 -%}{%- else -%}{%- assign w = w2 -%}{%- endcase -%}
  {%- unless forloop.first -%},{%- endunless -%}
  {%- if w.data == blank -%}null
  {%- elsif w.data contains 'id="liste_livres"' -%}[
    {%- assign items = w.data | split: 'id="liste_livres"' | last | split: '<h2 class="livre_titre">' -%}
    {%- for it in items offset: 1 limit: 16 -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {{- it | split: '</ul>' | first | strip_newlines | replace: '	', '' | replace: '    ', '' | json -}}
    {%- endfor -%}]
  {%- else -%}[]
  {%- endif -%}
{%- endfor -%}]{%- endcapture -%}
<div class="bp bp--{{ size }}{% if cf.style == 'color' %} bp--color{% else %} bp--eink{% endif %}"
     data-lang="{{ cf.language | default: 'fr' }}" data-featured="{{ cf.featured | default: 'rotate' }}"
     data-genre="{{ cf.genre | default: '1000000' }}" data-ts="{{ ts }}" data-off="{{ off | default: 0 }}">
  <!-- les plus demandés à paraître, parus ces deux dernières semaines, à paraître d'ici deux semaines -->
  <script type="application/json" class="bp-pages">{{ pages }}</script>
  <div class="bp-sky">
    <svg class="bp-rays" viewBox="0 0 1280 540" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="bp-dots" width="16" height="16" patternUnits="userSpaceOnUse">
          <rect width="16" height="16" fill="#fff"/>
          <circle cx="4" cy="4" r="1.6" fill="#000"/><circle cx="12" cy="12" r="1.6" fill="#000"/>
        </pattern>
      </defs>
      <g class="bp-rays-g" style="fill:var(--ray)"></g>
    </svg>
    <!-- la couverture, cernée de noir comme l'affiche de MoviePoster ; un livre ouvert si elle manque -->
    <div class="bp-art">
      <div class="bp-frame"><img class="bp-cover" alt=""><span class="bp-tag"></span></div>
      <svg class="bp-book" viewBox="-20 -10 460 340" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
        <path d="M215 85 C170 55 100 50 30 72 V300 C100 278 170 282 215 312 Z M215 85 C260 55 330 50 400 72 V300 C330 278 260 282 215 312 Z"
              style="fill:var(--book-fill);stroke:var(--ink)" stroke-width="10" stroke-linejoin="round"/>
        <path d="M70 115 C110 103 150 103 185 115 M70 155 C110 143 150 143 185 155 M70 195 C110 183 150 183 185 195 M70 235 C110 223 150 223 185 235
                 M245 155 C280 143 320 143 360 155 M245 195 C280 183 320 183 360 195 M245 235 C280 223 320 223 360 235"
              style="fill:none;stroke:var(--ink)" stroke-width="9" stroke-linecap="round"/>
        <path d="M290 62 V135 L310 118 L330 135 V58 Z" style="fill:var(--accent);stroke:var(--ink)" stroke-width="8" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="bp-top">
      <span class="bp-k"></span>
      <span class="bp-upd"><span class="bp-upd-long"></span><span class="bp-upd-short"></span><span class="bp-time">--:--</span></span>
    </div>
  </div>
  <div class="bp-info">
    <div class="bp-text">
      <div class="bp-meta"></div>
      <div class="bp-title"></div>
      <div class="bp-sub bp-by"></div>
      <div class="bp-sub bp-next"></div>
    </div>
    <div class="bp-stamp">
      <span class="bp-stamp-k"></span>
      <div class="bp-ring"></div>
      <span class="bp-stamp-l"></span>
    </div>
  </div>
</div>
{% endtemplate %}

<script>
(function () {
  var MONTHS = { janvier: 0, 'février': 1, fevrier: 1, mars: 2, avril: 3, mai: 4, juin: 5, juillet: 6, 'août': 7, aout: 7,
                 septembre: 8, octobre: 9, novembre: 10, 'décembre': 11, decembre: 11 };
  var GENRES = {
    fr: { '1000000': 'Littérature', '1000000-1010000': 'Romans', '90000000': 'Polar', '91000000': 'Fantasy & SF', '92000000': 'Romance',
          '3000000-3020000': 'BD', '3000000-3040000': 'Mangas', '2000000': 'Jeunesse', '9000000': 'Sciences humaines',
          '6000000': 'Arts', '4000000': 'Vie pratique' },
    en: { '1000000': 'Literature', '1000000-1010000': 'Novels', '90000000': 'Crime', '91000000': 'Fantasy & SF', '92000000': 'Romance',
          '3000000-3020000': 'Comics', '3000000-3040000': 'Manga', '2000000': 'Kids', '9000000': 'Humanities',
          '6000000': 'Arts', '4000000': 'Lifestyle' }
  };
  var I18N = {
    fr: {
      hot: 'Les plus attendus', now: 'Juste parus', upcoming: 'Prochainement',
      updated: 'Dernière actualisation à ', upd: 'Màj ',
      days: ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'],
      months: ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'],
      mshort: ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'],
      date: function (d, m, n) { return d + ' ' + (n === 1 ? '1er' : n) + ' ' + m; },
      dshort: function (m, n) { return n + ' ' + m; },
      rank: function (n) { return 'Nº ' + n + ' des plus attendus'; },
      since: function (n) { return n === 0 ? 'Paraît aujourd\'hui' : n === 1 ? 'Paru hier' : 'Paru il y a ' + n + ' jours'; },
      out: function (n) { return n === 0 ? 'Paraît aujourd\'hui' : n === 1 ? 'Paraît demain' : 'Paraît dans ' + n + ' jours'; },
      by: 'de ', then: 'Ensuite : ', also: 'Aussi : ', tagNew: 'Nouveau',
      outIn: 'Parution', sinceK: 'Paru il y a', day: 'jour', daysW: 'jours', today: 'Auj.',
      offlineMeta: 'Parutions indisponibles', offline: 'Hors ligne', noFeed: 'Impossible de joindre Place des Libraires pour le moment.',
      emptyMeta: 'Rien à afficher', empty: 'Aucun livre', emptyTxt: 'Aucune parution trouvée dans ce rayon.'
    },
    en: {
      hot: 'Most anticipated', now: 'Just out', upcoming: 'Coming soon',
      updated: 'Last updated at ', upd: 'Upd. ',
      days: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      months: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
      mshort: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
      date: function (d, m, n) { return d + ', ' + m + ' ' + n; },
      dshort: function (m, n) { return m + ' ' + n; },
      rank: function (n) { return 'No. ' + n + ' most anticipated'; },
      since: function (n) { return n === 0 ? 'Out today' : n === 1 ? 'Out since yesterday' : 'Out for ' + n + ' days'; },
      out: function (n) { return n === 0 ? 'Out today' : n === 1 ? 'Out tomorrow' : 'Out in ' + n + ' days'; },
      by: 'by ', then: 'Next: ', also: 'Also: ', tagNew: 'New',
      outIn: 'Out in', sinceK: 'Out for', day: 'day', daysW: 'days', today: 'Today',
      offlineMeta: 'Releases unavailable', offline: 'Offline', noFeed: 'Unable to reach Place des Libraires right now.',
      emptyMeta: 'Nothing to show', empty: 'No books', emptyTxt: 'No release found on this shelf.'
    }
  };

  function json(el) { try { return JSON.parse(el.textContent); } catch (e) { return null; } }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function txt(el) { return el ? el.textContent.replace(/\s+/g, ' ').trim() : ''; }
  // Titre : d'abord réduit sur une ligne, puis sur deux lignes s'il est encore trop long
  function fit(el) {
    el.style.fontSize = ''; el.classList.remove('wrap');
    var base = parseFloat(getComputedStyle(el).fontSize), size = base;
    var shrink = function () { size *= 0.94; el.style.fontSize = size + 'px'; };
    while (el.scrollWidth > el.clientWidth + 1 && size > base * 0.7) shrink();
    if (el.scrollWidth <= el.clientWidth + 1) return;
    el.classList.add('wrap');
    while ((el.scrollHeight > size * 2.1 + 2 || el.scrollWidth > el.clientWidth + 1) && size > base * 0.3) shrink();
  }

  // Les livres d'une liste, dans l'ordre du site (les plus demandés d'abord) et datés de leur parution.
  // Chaque entrée est le haut d'une fiche : titre, auteurs, éditeur, « 28 Octobre 2026 », EAN.
  function books(list) {
    var seen = {};
    return (list || []).map(function (html) {
      var doc = new DOMParser().parseFromString('<div><h2 class="livre_titre">' + html + '</div>', 'text/html');
      var m = /(\d{1,2})(?:er)?\s+(\S+)\s+(\d{4})/.exec(txt(doc.querySelector('.MiseEnLigne')).toLowerCase());
      var ean = (/\/livre\/(\d{13})/.exec(html) || [])[1];
      if (!m || !(m[2] in MONTHS) || !ean || seen[ean]) return null;
      seen[ean] = 1;
      var authors = [].map.call(doc.querySelectorAll('.livre_auteur a'), txt).filter(Boolean);
      return { title: txt(doc.querySelector('.livre_titre')), authors: authors, publisher: txt(doc.querySelector('.editeur')), ean: ean,
               day: Math.floor(Date.UTC(+m[3], MONTHS[m[2]], +m[1]) / 864e5) };
    }).filter(function (b) { return b && b.title; });
  }

  function render(root) {
    root.setAttribute('data-done', '1');
    var q = function (s) { return root.querySelector(s); };
    var lang = root.dataset.lang === 'en' ? 'en' : 'fr', t = I18N[lang];
    var ts = parseInt(root.dataset.ts, 10) || Math.floor(Date.now() / 1000), off = parseInt(root.dataset.off, 10) || 0;
    var pages = json(q('.bp-pages')) || [];

    q('.bp-upd-long').textContent = t.updated;
    q('.bp-upd-short').textContent = t.upd;
    q('.bp-time').textContent = new Date((ts + off) * 1000).toISOString().substr(11, 5);

    // Jours entiers entre aujourd'hui (heure locale) et la parution
    var today = Math.floor((ts + off) / 86400);
    var when = function (b, long) {
      var dt = new Date(b.day * 864e5);
      return long ? t.date(t.days[dt.getUTCDay()], t.months[dt.getUTCMonth()], dt.getUTCDate())
                  : t.dshort(t.mshort[dt.getUTCMonth()], dt.getUTCDate());
    };
    var lists = {
      // les plus demandés parmi ceux qui paraissent d'ici deux mois
      hot: books(pages[0]).filter(function (b) { return b.day > today; }),
      // parus ces deux dernières semaines, les plus demandés d'abord
      now: books(pages[1]).filter(function (b) { return b.day <= today && b.day > today - 14; }),
      // la prochaine parution, puis les suivantes ; le plus demandé d'abord pour un même jour
      upcoming: books(pages[2]).map(function (b, i) { b.rank = i; return b; })
        .filter(function (b) { return b.day > today; })
        .sort(function (a, b) { return a.day - b.day || a.rank - b.rank; })
    };

    // Rubrique et livre à l'affiche : fixés par le réglage, ou une rotation horaire parmi les trois premiers de chaque rubrique
    var secs = ['hot', 'now', 'upcoming'].filter(function (s) { return lists[s].length; });
    var sec = root.dataset.featured, idx = 0, slot = Math.floor(ts / 3600);
    if (!lists[sec] || !lists[sec].length) {
      sec = secs[slot % (secs.length || 1)];
      if (sec) idx = Math.floor(slot / secs.length) % Math.min(3, lists[sec].length);
    }
    root.classList.add('bp--sec-' + (sec || 'hot'));
    rays(root);
    var genre = GENRES[lang][root.dataset.genre];
    q('.bp-k').textContent = t[sec || 'hot'] + (genre ? ' · ' + genre : '');

    if (!sec) {
      var down = !pages.some(Array.isArray);
      root.classList.add('bp--error', 'bp--noimg');
      q('.bp-k').textContent = 'BookPoster';
      q('.bp-meta').textContent = down ? t.offlineMeta : t.emptyMeta;
      q('.bp-title').textContent = down ? t.offline : t.empty;
      q('.bp-by').textContent = down ? t.noFeed : t.emptyTxt;
      q('.bp-info').classList.add('bp-err');
      return fit(q('.bp-title'));
    }

    var list = lists[sec], b = list[idx], left = b.day - today;
    cover(root, 'https://images.epagine.fr/' + b.ean.substr(10) + '/' + b.ean + '_1_75.jpg');
    q('.bp-title').textContent = b.title;

    var meta;
    if (sec === 'hot') {
      meta = t.rank(idx + 1) + ' · ' + when(b, true);
      q('.bp-tag').textContent = 'Nº ' + (idx + 1);
    } else if (sec === 'now') {
      meta = t.since(Math.max(0, -left)) + ' · ' + when(b, true);
      if (-left < 7) q('.bp-tag').textContent = t.tagNew;
    } else meta = t.out(Math.max(0, left)) + ' · ' + when(b, true);
    q('.bp-meta').textContent = meta;

    var by = b.authors.length ? t.by + '<b>' + b.authors.slice(0, 2).map(esc).join(', ') + (b.authors.length > 2 ? '…' : '') + '</b>' : '';
    if (b.publisher) by += (by ? ' · ' : '') + esc(b.publisher);
    q('.bp-by').innerHTML = by;

    var others = [];
    list.forEach(function (o, i) {
      if (i === idx || others.length >= 4) return;
      var name = esc(o.title);
      if (sec === 'hot') others.push((i + 1) + '. ' + name + ' <b>' + when(o, false) + '</b>');
      else if (sec === 'now') others.push(name + (o.authors.length ? ' <b>' + esc(o.authors[0]) + '</b>' : ''));
      else others.push(name + ' <b>' + when(o, false) + '</b>');
    });
    q('.bp-next').innerHTML = others.length ? (sec === 'now' || idx ? t.also : t.then) + others.join(' · ') : '';

    // Tampon : le compte à rebours avant la parution, ou les jours depuis la parution
    var ring = q('.bp-ring'), n = Math.abs(left);
    q('.bp-stamp-k').textContent = n === 0 ? '' : sec === 'now' ? t.sinceK : t.outIn;
    ring.textContent = n === 0 ? t.today : n;
    if (n === 0) ring.classList.add('word'); else if (n > 99) ring.classList.add('long');
    q('.bp-stamp-l').textContent = n === 0 ? '' : n === 1 ? t.day : t.daysW;
    fit(q('.bp-title'));
  }

  // Couverture cadrée à son format d'origine dans la zone du ciel ;
  // sans couverture, le site renvoie une vignette « pas d'image » de 154 × 173
  function cover(root, url) {
    var img = root.querySelector('.bp-cover'), frame = root.querySelector('.bp-frame'), art = root.querySelector('.bp-art');
    var place = function () {
      var w = img.naturalWidth, h = img.naturalHeight;
      if (!w || !h || (w === 154 && h === 173)) return root.classList.add('bp--noimg');
      var k = Math.min(art.clientWidth / w, art.clientHeight / h);
      frame.style.width = Math.round(w * k) + 'px'; frame.style.height = Math.round(h * k) + 'px';
      root.classList.add('bp--img');
    };
    img.onload = place;
    img.onerror = function () { root.classList.add('bp--noimg'); };
    img.src = url;
    if (img.complete && img.naturalWidth) place();
  }

  // Rayons de soleil derrière la couverture
  function rays(root) {
    var NS = 'http://www.w3.org/2000/svg', g = root.querySelector('.bp-rays-g'), cx = 640, cy = 300, n = 18, r = 1600;
    for (var i = 0; i < n; i++) {
      var a0 = (i * 2) * Math.PI / n, a1 = (i * 2 + 1) * Math.PI / n;
      var p = document.createElementNS(NS, 'path');
      p.setAttribute('d', 'M' + cx + ' ' + cy + ' L' + (cx + r * Math.cos(a0)) + ' ' + (cy + r * Math.sin(a0))
        + ' L' + (cx + r * Math.cos(a1)) + ' ' + (cy + r * Math.sin(a1)) + ' Z');
      g.appendChild(p);
    }
  }

  function boot() { document.querySelectorAll('.bp:not([data-done])').forEach(render); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () {
    document.querySelectorAll('.bp-title').forEach(fit);
  });
})();
</script>
